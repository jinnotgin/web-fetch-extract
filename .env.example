NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Auth
# Empty means authentication is disabled. Set one or more comma-separated keys to require auth.
API_KEYS=change-me-local-dev-key

# Fetch policy
ALLOW_HTTP=false
ALLOW_PRIVATE_IPS=false
MAX_REDIRECTS=5
REQUEST_TIMEOUT_MS=15000
BROWSER_TIMEOUT_MS=25000
MAX_PDF_PAGES=30
MAX_OCR_PAGES=5
ENABLE_OCR=true
ENABLE_BROWSER_FALLBACK=true
MAX_BROWSER_CONCURRENCY=2
CORS_ORIGINS=*

# Domain controls. Comma-separated. Empty ALLOWED_DOMAINS means no allowlist.
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=localhost,127.0.0.1,169.254.169.254
